{
	"info": {
		"_postman_id": "atozshop-api-v1",
		"name": "A to Z Shop Management - Complete API Collection",
		"description": "Complete API collection for Phase 0 (Authentication) and Phase 1 (Inventory Management)\n\n## How to Use:\n1. Import this file into Postman\n2. Set up environment variables (or use the examples)\n3. Start with 'Auth - Register' to create a user\n4. Then 'Auth - Login' to get JWT token (automatically saved to {{token}})\n5. Test other endpoints (they use {{token}} automatically)\n\n## Environment Variables:\n- baseUrl: http://localhost:8080\n- token: (auto-set after login)\n- tenantId: 1\n- storeId: 1\n- categoryId: (set after creating category)\n- productId: (set after creating product)\n- variantId: (set after creating variant)\n- transactionId: (set after creating transaction)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set('token', jsonData.token);",
									"        pm.environment.set('tenantId', jsonData.tenantId);",
									"        console.log('Token saved:', jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenantId\": 1,\n  \"storeId\": 1,\n  \"email\": \"demo@atozshop.com\",\n  \"password\": \"Demo@1234\",\n  \"username\": \"demouser\",\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\",\n  \"phone\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Register a new user. Note: You need an existing tenant and store. Use tenantId=1 and storeId=1 for testing."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('token', jsonData.token);",
									"    pm.environment.set('tenantId', jsonData.tenantId);",
									"    console.log('Token saved:', jsonData.token);",
									"    console.log('Tenant ID:', jsonData.tenantId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@atozshop.com\",\n  \"password\": \"Demo@1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login and get JWT token. Token is automatically saved to environment variable."
					},
					"response": []
				},
				{
					"name": "Home (Test Auth)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/home",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "home"]
						},
						"description": "Test endpoint to verify authentication is working."
					},
					"response": []
				}
			],
			"description": "Phase 0 - Authentication APIs"
		},
