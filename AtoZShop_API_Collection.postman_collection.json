							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('transactionId', jsonData.id);",
									"    console.log('Transaction ID saved:', jsonData.id);",
									"    console.log('Transaction Number:', jsonData.transactionNumber);",
									"    console.log('Total Cost:', jsonData.totalCost);",
									"    console.log('Expected Profit:', jsonData.expectedProfit);",
									"}"
								],
								"type": "text/javascript"
